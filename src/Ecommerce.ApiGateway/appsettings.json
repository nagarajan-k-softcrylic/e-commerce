{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "EcommerceMicroservicesSecretKeyWithAtLeast256BitsLength!",
    "Issuer": "Ecommerce.ApiGateway",
    "Audience": "Ecommerce.Clients",
    "ExpiryMinutes": 120
  },
  "ReverseProxy": {
    "Routes": {
      "orders-route-api": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "orders-route-short": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/orders/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/orders/{**catch-all}" }
        ]
      },
      "products-route-api": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "products-route-short": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/products/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/products/{**catch-all}" }
        ]
      },
      "inventory-route-api": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        }
      },
      "inventory-route-short": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/inventory/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/inventory/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "order-cluster": {
        "Destinations": {
          "order-service-node": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "inventory-service-node": {
            "Address": "http://localhost:5102"
          }
        }
      }
    }
  }
}

