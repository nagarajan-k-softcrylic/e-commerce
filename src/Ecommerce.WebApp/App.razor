<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div class="card p-4 shadow-sm text-center my-5 mx-auto" style="max-width: 500px;">
                            <i class="fa-solid fa-lock text-warning display-4 mb-3"></i>
                            <h4 class="fw-bold">Access Denied</h4>
                            <p class="text-muted">You do not have permission to access this resource with your current role.</p>
                            <a href="" class="btn btn-primary mt-2">Back to Dashboard</a>
                        </div>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="card p-4 shadow-sm text-center my-5 mx-auto" style="max-width: 500px;">
                    <i class="fa-solid fa-triangle-exclamation text-danger display-4 mb-3"></i>
                    <h4 class="fw-bold">Page Not Found</h4>
                    <p class="text-muted">The requested page does not exist.</p>
                    <a href="" class="btn btn-primary mt-2">Back to Dashboard</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
