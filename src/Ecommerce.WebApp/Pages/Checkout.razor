@page "/checkout"
@attribute [Authorize]
@inject CartService CartService
@inject IOrderService OrderService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="mb-4">
    <h2 class="fw-bold text-dark mb-1">Shopping Cart & Checkout</h2>
    <p class="text-muted mb-0">Review items, verify customer information, and submit your order</p>
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <Alert Color="Color.Danger" Visible="true" Class="mb-3">
        <AlertMessage>Order Failed</AlertMessage>
        <AlertDescription>@_errorMessage</AlertDescription>
    </Alert>
}

@if (_orderSubmitted && _createdOrder != null)
{
    <Card Class="stat-card border-0 bg-white shadow-sm mb-4">
        <CardBody Class="p-5 text-center">
            <div class="icon-box bg-success text-white mx-auto mb-3" style="width: 64px; height: 64px;">
                <i class="fa-solid fa-check fs-2"></i>
            </div>
            <h3 class="fw-bold text-dark">Order Successfully Dispatched!</h3>
            <p class="text-muted">
                Order Reference: <strong class="text-primary font-monospace">@_createdOrder.OrderNumber</strong>
            </p>
            <div class="badge bg-warning text-dark p-2 fs-6 mb-3">
                <i class="fa-solid fa-bolt me-1"></i> Current Status: @_createdOrder.Status
            </div>
            <p class="text-muted small mx-auto" style="max-width: 600px;">
                An <code>OrderCreatedEvent</code> has been dispatched across Azure Service Bus to the Inventory Microservice
                to validate warehouse stock and reserve items asynchronously.
            </p>
            <div class="d-flex justify-content-center gap-3 mt-4">
                <a href="@($"orders/{_createdOrder.Id}")" class="btn btn-primary">
                    <i class="fa-solid fa-timeline me-1"></i> View Order & Event Timeline
                </a>
                <a href="products" class="btn btn-outline-secondary">
                    Continue Shopping
                </a>
            </div>
        </CardBody>
    </Card>
}
else if (CartService.Items.Count == 0)
{
    <Card Class="stat-card border-0 bg-white shadow-sm text-center py-5">
        <CardBody>
            <div class="icon-box bg-light text-muted mx-auto mb-3" style="width: 64px; height: 64px;">
                <i class="fa-solid fa-cart-shopping fs-2"></i>
            </div>
            <h4 class="fw-bold">Your Cart is Empty</h4>
            <p class="text-muted">Browse our product catalog to discover premium tech gear.</p>
            <a href="products" class="btn btn-primary mt-2">
                <i class="fa-solid fa-bag-shopping me-1"></i> Browse Products
            </a>
        </CardBody>
    </Card>
}
else
{
    <div class="row g-4">
        <!-- Cart Items List -->
        <div class="col-12 col-lg-8">
            <Card Class="stat-card border-0 bg-white shadow-sm">
                <CardHeader Class="bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Cart Items (@CartService.TotalItemCount)</h5>
                    <button class="btn btn-link text-danger text-decoration-none btn-sm" @onclick="ClearCart">
                        <i class="fa-solid fa-trash me-1"></i> Clear Cart
                    </button>
                </CardHeader>
                <CardBody class="p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Product Name</th>
                                    <th>Price</th>
                                    <th style="width: 140px;">Quantity</th>
                                    <th>Subtotal</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in CartService.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold text-dark">@item.ProductName</div>
                                            <span class="badge bg-light text-muted font-monospace">@item.ProductCode</span>
                                        </td>
                                        <td>@item.Price.ToString("C2")</td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <button class="btn btn-outline-secondary" @onclick="@(() => UpdateQuantity(item.ProductId, item.Quantity - 1))">-</button>
                                                <input type="text" class="form-control text-center" value="@item.Quantity" readonly />
                                                <button class="btn btn-outline-secondary" @onclick="@(() => UpdateQuantity(item.ProductId, item.Quantity + 1))">+</button>
                                            </div>
                                        </td>
                                        <td class="fw-bold text-dark">@item.SubTotal.ToString("C2")</td>
                                        <td>
                                            <button class="btn btn-link text-danger p-0" @onclick="@(() => RemoveItem(item.ProductId))">
                                                <i class="fa-solid fa-xmark"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </CardBody>
            </Card>
        </div>

        <!-- Customer Info & Summary Card -->
        <div class="col-12 col-lg-4">
            <!-- Customer Information Card -->
            <Card Class="stat-card border-0 bg-white shadow-sm mb-3">
                <CardHeader Class="bg-transparent border-0 pt-3 pb-0">
                    <h5 class="fw-bold mb-0">Customer Information</h5>
                </CardHeader>
                <CardBody Class="pt-2">
                    <div class="mb-2">
                        <span class="text-muted small">Customer Email:</span>
                        <div class="fw-semibold text-dark">@_customerEmail</div>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted small">Customer Identifier:</span>
                        <div class="fw-semibold text-dark font-monospace small">@_customerId</div>
                    </div>
                    <div>
                        <span class="text-muted small">Fulfillment Channel:</span>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle d-inline-block">
                            Azure Service Bus Event Sourcing
                        </span>
                    </div>
                </CardBody>
            </Card>

            <!-- Order Total Card -->
            <Card Class="stat-card border-0 bg-white shadow-sm">
                <CardHeader Class="bg-transparent border-0 pt-3 pb-0">
                    <h5 class="fw-bold mb-0">Order Summary</h5>
                </CardHeader>
                <CardBody Class="pt-2">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal</span>
                        <span class="fw-semibold">@CartService.TotalAmount.ToString("C2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Shipping & Handling</span>
                        <span class="text-success fw-semibold">Free</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fw-bold fs-5 text-dark">Total Amount</span>
                        <span class="fw-bold fs-4 text-primary">@CartService.TotalAmount.ToString("C2")</span>
                    </div>

                    <Button Color="Color.Primary"
                            Class="w-100 py-3 fw-bold fs-6"
                            Loading="@_isSubmitting"
                            Clicked="PlaceOrderAsync">
                        <i class="fa-solid fa-lock me-2"></i> Place Order Now
                    </Button>
                </CardBody>
            </Card>
        </div>
    </div>
}

@code {
    private string _customerEmail = "customer@ecommerce.com";
    private string _customerId = "customer-user-01";
    private bool _isSubmitting = false;
    private bool _orderSubmitted = false;
    private OrderDto? _createdOrder;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _customerEmail = user.Identity.Name ?? "customer@ecommerce.com";
            _customerId = user.FindFirst("customerId")?.Value ?? user.Identity.Name ?? "customer-user-01";
        }
    }

    private async Task UpdateQuantity(Guid productId, int newQty)
    {
        await CartService.UpdateQuantityAsync(productId, newQty);
    }

    private async Task RemoveItem(Guid productId)
    {
        await CartService.RemoveItemAsync(productId);
    }

    private async Task ClearCart()
    {
        await CartService.ClearCartAsync();
    }

    private async Task PlaceOrderAsync()
    {
        if (CartService.Items.Count == 0) return;

        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            // If single item, use checkout endpoint; if multiple, use CreateOrder endpoint
            if (CartService.Items.Count == 1)
            {
                var item = CartService.Items[0];
                var request = new CheckoutOrderRequest
                {
                    CustomerId = _customerEmail,
                    ProductId = item.ProductId,
                    ProductName = item.ProductName,
                    Quantity = item.Quantity,
                    Price = item.Price
                };

                _createdOrder = await OrderService.CheckoutAsync(request);
            }
            else
            {
                var request = new CreateOrderRequest
                {
                    CustomerId = _customerEmail,
                    Items = CartService.Items.Select(i => new CreateOrderItemRequest(
                        i.ProductId,
                        i.ProductName,
                        i.Quantity,
                        i.Price
                    )).ToList()
                };

                _createdOrder = await OrderService.CreateOrderAsync(request);
            }

            if (_createdOrder != null)
            {
                await CartService.ClearCartAsync();
                _orderSubmitted = true;
            }
            else
            {
                _errorMessage = "Order submission returned an unexpected empty response from Order Service.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to place order: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}

