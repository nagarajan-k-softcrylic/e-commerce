@page "/login"
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="row justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="col-12 col-md-8 col-lg-5">
        <Card Class="shadow-sm border-0 stat-card">
            <CardHeader Class="bg-white border-0 text-center pt-4 pb-2">
                <div class="icon-box bg-primary text-white mx-auto mb-3">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h3 class="fw-bold mb-1">Corporate Portal Sign In</h3>
                <p class="text-muted small">Enter your microservices credentials to continue</p>
            </CardHeader>
            <CardBody Class="p-4 pt-2">
                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <Alert Color="Color.Danger" Visible="true" Class="mb-3">
                        <AlertMessage>Sign in failed</AlertMessage>
                        <AlertDescription>@_errorMessage</AlertDescription>
                    </Alert>
                }

                <form @onsubmit="HandleLogin">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-envelope text-muted"></i></span>
                            <input type="email" class="form-control border-start-0" placeholder="user@ecommerce.com" @bind="_email" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold small text-secondary">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-key text-muted"></i></span>
                            <input type="password" class="form-control border-start-0" placeholder="••••••••" @bind="_password" required />
                        </div>
                    </div>

                    <Button Type="ButtonType.Submit" Color="Color.Primary" Class="w-100 py-2 fw-semibold" Loading="@_isLoading">
                        <i class="fa-solid fa-arrow-right-to-bracket me-2"></i> Sign In
                    </Button>
                </form>

                <div class="mt-4 pt-3 border-top">
                    <span class="d-block text-muted small fw-semibold text-center mb-2">QUICK FILL DEMO CREDENTIALS:</span>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-danger btn-sm flex-fill" @onclick="FillAdmin">
                            <i class="fa-solid fa-user-shield me-1"></i> Admin Demo
                        </button>
                        <button type="button" class="btn btn-outline-success btn-sm flex-fill" @onclick="FillCustomer">
                            <i class="fa-solid fa-user me-1"></i> Customer Demo
                        </button>
                    </div>
                </div>
            </CardBody>
        </Card>
    </div>
</div>

@code {
    private string _email = "admin@ecommerce.com";
    private string _password = "Admin123!";
    private string? _errorMessage;
    private bool _isLoading = false;

    private void FillAdmin()
    {
        _email = "admin@ecommerce.com";
        _password = "Admin123!";
        _errorMessage = null;
    }

    private void FillCustomer()
    {
        _email = "customer@ecommerce.com";
        _password = "Customer123!";
        _errorMessage = null;
    }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await AuthService.LoginAsync(new LoginRequestDto(_email, _password));
            if (result.Success)
            {
                Navigation.NavigateTo("", forceLoad: true);
            }
            else
            {
                _errorMessage = result.Message ?? "Invalid credentials. Please verify and try again.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unable to connect to API Gateway: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}

