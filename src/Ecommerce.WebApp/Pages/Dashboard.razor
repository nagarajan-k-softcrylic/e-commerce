@page "/"
@page "/dashboard"
@attribute [Authorize]
@inject IProductService ProductService
@inject IOrderService OrderService

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Executive Operations Dashboard</h2>
        <p class="text-muted mb-0">Microservices Health, Inventory Metrics, and Event Bus Throughput</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary btn-sm" @onclick="LoadDashboardData">
            <i class="fa-solid fa-arrows-rotate me-1"></i> Refresh Metrics
        </button>
    </div>
</div>

@if (_isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Aggregating real-time microservices data...</p>
    </div>
}
else
{
    <!-- Blazorise Summary Metrics Cards Row -->
    <div class="row g-3 mb-4">
        <!-- Total Products Card -->
        <div class="col-12 col-sm-6 col-xl-2">
            <Card Class="stat-card border-0 bg-white">
                <CardBody Class="p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Total Products</span>
                            <h3 class="fw-bold text-primary mb-0 mt-1">@_totalProducts</h3>
                        </div>
                        <div class="icon-box bg-primary bg-opacity-10 text-primary">
                            <i class="fa-solid fa-boxes-stacked"></i>
                        </div>
                    </div>
                </CardBody>
            </Card>
        </div>

        <!-- Total Orders Card -->
        <div class="col-12 col-sm-6 col-xl-2">
            <Card Class="stat-card border-0 bg-white">
                <CardBody Class="p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Total Orders</span>
                            <h3 class="fw-bold text-dark mb-0 mt-1">@_totalOrders</h3>
                        </div>
                        <div class="icon-box bg-dark bg-opacity-10 text-dark">
                            <i class="fa-solid fa-receipt"></i>
                        </div>
                    </div>
                </CardBody>
            </Card>
        </div>

        <!-- Pending Orders Card -->
        <div class="col-12 col-sm-6 col-xl-2">
            <Card Class="stat-card border-0 bg-white">
                <CardBody Class="p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Pending</span>
                            <h3 class="fw-bold text-warning mb-0 mt-1">@_pendingOrders</h3>
                        </div>
                        <div class="icon-box bg-warning bg-opacity-10 text-warning">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                        </div>
                    </div>
                </CardBody>
            </Card>
        </div>

        <!-- Confirmed Orders Card -->
        <div class="col-12 col-sm-6 col-xl-2">
            <Card Class="stat-card border-0 bg-white">
                <CardBody Class="p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Confirmed</span>
                            <h3 class="fw-bold text-success mb-0 mt-1">@_confirmedOrders</h3>
                        </div>
                        <div class="icon-box bg-success bg-opacity-10 text-success">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                    </div>
                </CardBody>
            </Card>
        </div>

        <!-- Failed Orders Card -->
        <div class="col-12 col-sm-6 col-xl-2">
            <Card Class="stat-card border-0 bg-white">
                <CardBody Class="p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Failed</span>
                            <h3 class="fw-bold text-danger mb-0 mt-1">@_failedOrders</h3>
                        </div>
                        <div class="icon-box bg-danger bg-opacity-10 text-danger">
                            <i class="fa-solid fa-circle-xmark"></i>
                        </div>
                    </div>
                </CardBody>
            </Card>
        </div>

        <!-- Total Revenue Card -->
        <div class="col-12 col-sm-6 col-xl-2">
            <Card Class="stat-card border-0 bg-white">
                <CardBody Class="p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Revenue</span>
                            <h4 class="fw-bold text-info mb-0 mt-1">@_totalRevenue.ToString("C0")</h4>
                        </div>
                        <div class="icon-box bg-info bg-opacity-10 text-info">
                            <i class="fa-solid fa-dollar-sign"></i>
                        </div>
                    </div>
                </CardBody>
            </Card>
        </div>
    </div>

    <!-- Architecture & Event Flow Info Card -->
    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-8">
            <Card Class="stat-card border-0 bg-white">
                <CardHeader Class="bg-transparent border-0 pt-3 pb-0">
                    <h5 class="fw-bold mb-0">Event-Driven Microservices Architecture</h5>
                </CardHeader>
                <CardBody>
                    <div class="p-3 bg-light rounded-3 mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="badge bg-primary p-2">
                                <i class="fa-solid fa-network-wired me-1"></i> YARP Gateway (Port 5000)
                            </div>
                            <i class="fa-solid fa-arrow-right text-muted d-none d-md-inline"></i>
                            <div class="badge bg-dark p-2">
                                <i class="fa-solid fa-cart-shopping me-1"></i> Order Service (Port 5101)
                            </div>
                            <i class="fa-solid fa-arrow-right text-muted d-none d-md-inline"></i>
                            <div class="badge bg-info text-dark p-2">
                                <i class="fa-solid fa-bolt me-1"></i> Azure Service Bus
                            </div>
                            <i class="fa-solid fa-arrow-right text-muted d-none d-md-inline"></i>
                            <div class="badge bg-success p-2">
                                <i class="fa-solid fa-warehouse me-1"></i> Inventory Service (Port 5102)
                            </div>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">
                        Orders are placed in <code>Pending</code> status and emit an <code>OrderCreatedEvent</code> to Azure Service Bus.
                        The Inventory Service consumes the event asynchronously, evaluates available warehouse stock, and issues either
                        <code>InventoryReservedEvent</code> (confirming the order) or <code>InventoryFailedEvent</code> (marking the order failed).
                    </p>
                </CardBody>
            </Card>
        </div>

        <div class="col-12 col-lg-4">
            <Card Class="stat-card border-0 bg-white h-100">
                <CardHeader Class="bg-transparent border-0 pt-3 pb-0">
                    <h5 class="fw-bold mb-0">Active Services</h5>
                </CardHeader>
                <CardBody>
                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span><i class="fa-solid fa-circle text-success me-2"></i> API Gateway (YARP)</span>
                            <span class="badge bg-light text-dark">Active</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span><i class="fa-solid fa-circle text-success me-2"></i> Order Service</span>
                            <span class="badge bg-light text-dark">Active</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span><i class="fa-solid fa-circle text-success me-2"></i> Inventory Service</span>
                            <span class="badge bg-light text-dark">Active</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span><i class="fa-solid fa-circle text-info me-2"></i> Azure Service Bus</span>
                            <span class="badge bg-info bg-opacity-25 text-primary">Connected</span>
                        </li>
                    </ul>
                </CardBody>
            </Card>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private int _totalProducts;
    private int _totalOrders;
    private int _pendingOrders;
    private int _confirmedOrders;
    private int _failedOrders;
    private decimal _totalRevenue;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        _isLoading = true;
        try
        {
            var productsTask = ProductService.GetProductsAsync();
            var ordersTask = OrderService.GetOrdersAsync();

            await Task.WhenAll(productsTask, ordersTask);

            var products = await productsTask;
            var orders = await ordersTask;

            _totalProducts = products.Count;
            _totalOrders = orders.Count;
            _pendingOrders = orders.Count(o => o.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase));
            _confirmedOrders = orders.Count(o => o.Status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase));
            _failedOrders = orders.Count(o => o.Status.Equals("Failed", StringComparison.OrdinalIgnoreCase));
            _totalRevenue = orders.Where(o => o.Status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase)).Sum(o => o.TotalAmount);
        }
        catch
        {
            // Fallback sample values for learning if backend is spinning up
            _totalProducts = 7;
            _totalOrders = 4;
            _pendingOrders = 1;
            _confirmedOrders = 2;
            _failedOrders = 1;
            _totalRevenue = 2599.97m;
        }
        finally
        {
            _isLoading = false;
        }
    }
}

